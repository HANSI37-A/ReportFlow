# Database Configuration (Backend)
DB_URL=jdbc:postgresql://localhost:5432/weekly_report_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# PostgreSQL Container Configuration (Docker)
POSTGRES_DB=weekly_report_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT Secret Configuration
# NOTE: Set a strong, randomly-generated secret key (256-bit+ / 32+ characters) in production
JWT_SECRET=change-this-to-a-long-random-secret-key-for-development-only
JWT_EXPIRATION=86400000
